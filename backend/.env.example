# ServisHP Pro — contoh env production Ubuntu
# Copy ke backend/.env lalu isi SECRET_KEY yang kuat:
#   cp backend/.env.example backend/.env
# Generate key:  python -c "import secrets; print(secrets.token_hex(32))"

# WAJIB diganti di server! Minimal 32 karakter acak.
SECRET_KEY=ganti-dengan-min-32-karakter-acak-contoh-isi-di-server
ACCESS_TOKEN_EXPIRE_DAYS=7

# SQLite default NATIVE (192.168.18.50): file di folder backend/ (aman untuk user poskonter).
# Untuk Docker, docker-compose.yml otomatis menimpa dengan sqlite:////data/servishp.db via environment.
DATABASE_URL=sqlite:///./servishp.db
# Contoh Postgres (aktifkan psycopg2-binary di requirements bila dipakai):
# DATABASE_URL=postgresql+psycopg2://pos:RAHASIA@localhost:5432/poskonter

# LAN 192.168.18.x: "*" oke. Kunci bila sudah punya domain HTTPS.
# Contoh dikunci: https://pos.pitujaya.my.id,https://api.pitujaya.my.id
CORS_ORIGINS=*

PORT=8000
UVICORN_WORKERS=2
APP_VERSION=1.1.0-ubuntu
# FRONTEND_DIR & UPLOAD_DIR biasanya di-set oleh docker-compose / systemd, tidak wajib diisi:
# FRONTEND_DIR=/app/frontend
# UPLOAD_DIR=/data/uploads
